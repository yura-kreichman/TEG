"X-Domain: fluent-cart\n"

msgid "Too many applied coupons supplied. Send at most %d."
msgstr "Передано слишком много купонов. Можно не больше %d."

msgid "Product not found."
msgstr "Товар не найден."

msgid "Order totals could not be recalculated. Please try again."
msgstr "Не удалось пересчитать итоги заказа. Попробуйте ещё раз."

msgid "Coupon discounts have changed. Please re-apply the coupons and save again."
msgstr "Скидки по купонам изменились. Примените купоны заново и сохраните ещё раз."

msgid "A product price changed. Remove it and add it again."
msgstr "Цена товара изменилась. Удалите его и добавьте снова."

msgid "Unsupported action — this endpoint changes order or shipping status only."
msgstr "Неподдерживаемое действие: этот адрес меняет только статус заказа или доставки."

msgid "Review not found"
msgstr "Отзыв не найден"

msgid "A valid product is required"
msgstr "Нужен существующий товар"

msgid "Failed to create review"
msgstr "Не удалось создать отзыв"

msgid "Failed to update review"
msgstr "Не удалось обновить отзыв"

msgid "Review updated successfully"
msgstr "Отзыв обновлён"

msgid "No valid reviews found"
msgstr "Подходящих отзывов не найдено"

msgid "All selected reviews already have a reply."
msgstr "У всех выбранных отзывов уже есть ответ."

msgid "Failed to create replies"
msgstr "Не удалось создать ответы"

msgid "Successfully replied to %d review(s)."
msgstr "Отправлено ответов на отзывы: %d."

msgid "%d review(s) skipped — they already have a reply."
msgstr "Пропущено отзывов: %d, на них уже есть ответ."

msgid "Failed to delete review"
msgstr "Не удалось удалить отзыв"

msgid "Review deleted successfully"
msgstr "Отзыв удалён"

msgid "No reviews selected"
msgstr "Отзывы не выбраны"

msgid "Invalid action"
msgstr "Недопустимое действие"

msgid "Reviews not found"
msgstr "Отзывы не найдены"

msgid "Bulk action completed successfully"
msgstr "Массовое действие выполнено"

msgid "Half-yearly"
msgstr "Раз в полгода"

msgid "on the due date"
msgstr "в день оплаты"

msgid "%d day before due date"
msgid_plural "%d days before due date"
msgstr[0] "За %d день до срока оплаты"
msgstr[1] "За %d дня до срока оплаты"
msgstr[2] "За %d дней до срока оплаты"

msgid "The store currency is the base currency for every exchange rate and report, so it cannot be changed while multi-currency is enabled and orders exist. Disable it in %1$sMulti Currency settings%2$s to change the currency."
msgstr "Валюта магазина служит базовой для всех курсов и отчётов, поэтому её нельзя менять, пока включена мультивалютность и есть заказы. Отключите её в %1$sнастройках мультивалютности%2$s, чтобы сменить валюту."

msgid "Date & Time Format"
msgstr "Формат даты и времени"

msgid "Which date and time format to display. `Smart` keeps FluentCart's own format; `WordPress` follows Settings &rarr; General."
msgstr "В каком формате показывать дату и время. `Smart` сохраняет собственный формат FluentCart, `WordPress` берёт формат из Настройки &rarr; Общие."

msgid "Smart"
msgstr "Smart"

msgid "WordPress"
msgstr "WordPress"

msgid "Timezone"
msgstr "Часовой пояс"

msgid "Which timezone to display dates in. `Browser` shows admin and dashboard dates in the viewer's own timezone, and renders emails and invoices in the timezone captured at checkout; `WordPress` uses the site timezone from Settings &rarr; General."
msgstr "В каком часовом поясе показывать даты. `Browser` показывает даты в админке и кабинете в часовом поясе смотрящего, а письма и счета выводит в поясе, сохранённом при оформлении заказа; `WordPress` берёт часовой пояс сайта из Настройки &rarr; Общие."

msgid "Browser"
msgstr "Браузер"

msgid "Select Order Review Page"
msgstr "Выберите страницу отзывов о заказе"

msgid "Select the page where customers will review the products they bought, from the link in their order email."
msgstr "Страница, на которой клиенты оставляют отзывы о купленных товарах по ссылке из письма о заказе."

msgid "Review Your Order"
msgstr "Оцените ваш заказ"

msgid "Choose which sections to display on the single product page."
msgstr "Выберите, какие разделы показывать на странице товара."

msgid "Show Reviews In Single Page"
msgstr "Показывать отзывы на странице товара"

msgid "For block themes, add the Product Reviews block to your Single Product template to display reviews on your product page."
msgstr "Для блочных тем добавьте блок «Отзывы о товаре» в шаблон страницы товара, чтобы на ней появились отзывы."

msgid "Product Rating"
msgstr "Рейтинг товара"

msgid "Show star ratings when reviews are enabled."
msgstr "Показывать звёзды рейтинга, когда отзывы включены."

msgid "Show Rating in Shop"
msgstr "Показывать рейтинг в магазине"

msgid "Show Rating in Relevant Products"
msgstr "Показывать рейтинг в похожих товарах"

msgid "Compliance"
msgstr "Соответствие требованиям"

msgid "Customer email verification"
msgstr "Подтверждение почты клиента"

msgid "Confirm email ownership before customers access their portal and saved checkout addresses."
msgstr "Подтверждать владение адресом почты, прежде чем клиент получит доступ к кабинету и сохранённым адресам."

msgid "Not required"
msgstr "Не требуется"

msgid "When not required, new checkout accounts are linked to their purchases immediately."
msgstr "Если подтверждение не требуется, новые аккаунты, созданные при оформлении заказа, сразу связываются с покупками."

msgid "Login after account creation"
msgstr "Вход после создания аккаунта"

msgid "Choose how customers sign in after registering or completing checkout."
msgstr "Как клиент входит после регистрации или оформления заказа."

msgid "Log in automatically"
msgstr "Входить автоматически"

msgid "Let customers log in"
msgstr "Клиент входит сам"

msgid "Email verification still applies when required above."
msgstr "Подтверждение почты всё равно действует, если оно включено выше."

msgid "Early Payment"
msgstr "Досрочная оплата"

msgid "Let customers pay remaining installments before their due date."
msgstr "Разрешить клиентам оплачивать оставшиеся платежи рассрочки до срока."

msgid "Renewal Billing"
msgstr "Оплата продлений"

msgid "Choose how recurring subscription payments are collected."
msgstr "Выберите, как собираются регулярные платежи по подпискам."

msgid "Staging Protection"
msgstr "Защита тестовой копии"

msgid "Prevent staging or test copies of your store from billing real customers."
msgstr "Не даёт тестовым копиям магазина списывать деньги с настоящих клиентов."

msgid "Don't bill live subscriptions from this site while it is in test mode"
msgstr "Не выставлять счета по живым подпискам с этого сайта, пока он в тестовом режиме"

msgid "In test mode, this site won't invoice, charge, or email live subscriptions — so a staging copy can never double-bill customers. Billing from this site resumes when it is live again."
msgstr "В тестовом режиме этот сайт не выставляет счета, не списывает деньги и не отправляет письма по живым подпискам, так что тестовая копия никогда не спишет оплату дважды. Как только сайт снова работает в рабочем режиме, счета выставляются как обычно."

msgid "FluentCart's own style"
msgstr "Собственный стиль FluentCart"

msgid "The storefront keeps the colors and corner rounding it ships with."
msgstr "Витрина сохраняет цвета и скругления, с которыми поставляется плагин."

msgid "Inherit from the active theme"
msgstr "Брать из активной темы"

msgid "FluentCart uses your active theme's colors, and its button and form field corner rounding, for the storefront. Product cards keep FluentCart's corners. If something doesn't come through as expected, choose Customize to set it yourself."
msgstr "FluentCart берёт для витрины цвета активной темы и скругление её кнопок и полей формы. Карточки товаров сохраняют скругления FluentCart. Если что-то выглядит не так, как ожидалось, выберите «Настроить» и задайте вручную."

msgid "Customize"
msgstr "Настроить"

msgid "Pick the colors and corner rounding yourself. Only what you set is written to the storefront."
msgstr "Задайте цвета и скругления сами. На витрину попадёт только то, что вы задали."

msgid "Where colors and corner rounding come from"
msgstr "Откуда берутся цвета и скругления"

msgid "Storefront colors and corner rounding cascade from a small set of globals, so changing one here updates every page that uses it."
msgstr "Цвета и скругления витрины задаются небольшим набором общих значений, поэтому изменение здесь обновляет каждую страницу, где оно используется."

msgid "Appearance"
msgstr "Внешний вид"

msgid "Set only the colors you want to change — anything you leave unset keeps FluentCart's own default."
msgstr "Задайте только те цвета, которые хотите изменить. Всё, что не задано, остаётся по умолчанию FluentCart."

msgid "The active theme publishes no colors to inherit, so the storefront keeps FluentCart's own colors."
msgstr "Активная тема не публикует цвета для наследования, поэтому витрина сохраняет цвета FluentCart."

msgid "This theme publishes its palette as CSS variables. The storefront reads them, but they cannot be resolved here — the preview shows FluentCart's colors in their place."
msgstr "Эта тема публикует палитру как CSS-переменные. Витрина их читает, но здесь их не вычислить, поэтому в предпросмотре вместо них цвета FluentCart."

msgid "Border radius"
msgstr "Скругление углов"

msgid "A number is read as pixels, or add a unit: 8, 8px, 0.5rem, 1em. Leave a field empty to keep FluentCart's default."
msgstr "Число читается как пиксели, или добавьте единицу: 8, 8px, 0.5rem, 1em. Оставьте поле пустым, чтобы сохранить значение FluentCart по умолчанию."

msgid "Use a number, optionally with px, rem or em."
msgstr "Укажите число, можно с px, rem или em."

msgid "Default: %1$s"
msgstr "По умолчанию: %1$s"

msgid "%1$s Default: %2$s"
msgstr "%1$s По умолчанию: %2$s"

msgid "Your account has been created. Please check your email to set your password and log in."
msgstr "Аккаунт создан. Проверьте почту, чтобы задать пароль и войти."

msgid "All Products"
msgstr "Все товары"

msgid "Reviews"
msgstr "Отзывы"

msgid "Dynamic Pricing"
msgstr "Динамические цены"

msgid "Please enter a product quantity between 1 and %d."
msgstr "Укажите количество товара от 1 до %d."

msgid "The order total is too large to process. Please reduce the quantity."
msgstr "Сумма заказа слишком велика для обработки. Уменьшите количество."

msgid "Payment Method Title"
msgstr "Название способа оплаты"

msgid "Order Review Link"
msgstr "Ссылка на отзыв о заказе"

msgid "Store Seller Name (company, else store name)"
msgstr "Продавец магазина (компания или название магазина)"

msgid "Installment count must be 2 or more. A single installment is just a one-time payment — set the payment type to one-time instead."
msgstr "Платежей в рассрочке должно быть 2 или больше. Один платёж это просто разовая оплата, выберите вместо этого тип оплаты «разовый»."

msgid "on the last day"
msgstr "в последний день"

msgid "on the %s"
msgstr "%s числа"

msgid "in %s"
msgstr "в %s"

msgid "Payment Scheduled"
msgstr "Платёж запланирован"

msgid "This block will display the shopping cart."
msgstr "Этот блок показывает корзину."

msgid "Cart Checkout Button"
msgstr "Кнопка оформления заказа в корзине"

msgid "Currency Switcher"
msgstr "Переключатель валют"

msgid "Shows when Settings → Multi Currency offers more than one currency."
msgstr "Показывается, когда в Настройки → Мультивалютность доступно больше одной валюты."

msgid "The currency switcher is a FluentCart Pro feature. It shows nothing on your site until FluentCart Pro is active."
msgstr "Переключатель валют работает только в FluentCart Pro. Пока FluentCart Pro не активен, на сайте он ничего не показывает."

msgid "Display the star rating for a product."
msgstr "Показывает звёздный рейтинг товара."

msgid "Review Form"
msgstr "Форма отзыва"

msgid "The review submission form itself, printed on the page."
msgstr "Сама форма отправки отзыва, выводится на странице."

msgid "Review Count"
msgstr "Количество отзывов"

msgid "Review Filter"
msgstr "Фильтр отзывов"

msgid "Review Sorting"
msgstr "Сортировка отзывов"

msgid "Review Pagination"
msgstr "Страницы отзывов"

msgid "Review Item"
msgstr "Отзыв"

msgid "Review Author Avatar"
msgstr "Аватар автора отзыва"

msgid "Review Author Name"
msgstr "Имя автора отзыва"

msgid "Review Verified Badge"
msgstr "Значок подтверждённой покупки"

msgid "Review Variation Title"
msgstr "Название вариации в отзыве"

msgid "Review Rating"
msgstr "Оценка в отзыве"

msgid "Review Date"
msgstr "Дата отзыва"

msgid "Review Title"
msgstr "Заголовок отзыва"

msgid "Review Content"
msgstr "Текст отзыва"

msgid "Review Photos"
msgstr "Фото к отзыву"

msgid "Review Votes"
msgstr "Голоса за отзыв"

msgid "Review Reply"
msgstr "Ответ на отзыв"

msgid "Newest"
msgstr "Сначала новые"

msgid "Oldest"
msgstr "Сначала старые"

msgid "Highest Rating"
msgstr "Высокая оценка"

msgid "Lowest Rating"
msgstr "Низкая оценка"

msgid "%s Reviews"
msgstr "Отзывы: %s"

msgid "Sort reviews"
msgstr "Сортировка отзывов"

msgid "Verified Purchase"
msgstr "Подтверждённая покупка"

msgid "View Reply"
msgstr "Показать ответ"

msgid "Reply"
msgstr "Ответить"

msgid "Review List"
msgstr "Список отзывов"

msgid "Customer reviews for a product with sorting and pagination."
msgstr "Отзывы клиентов о товаре с сортировкой и разбивкой на страницы."

msgid "Product Reviews"
msgstr "Отзывы о товаре"

msgid "Display customer reviews and ratings for a product."
msgstr "Показывает отзывы и оценки клиентов о товаре."

msgid "Rating Summary"
msgstr "Сводка оценок"

msgid "Average rating and star distribution for a product."
msgstr "Средняя оценка и распределение звёзд для товара."

msgid "Rating Summary with Review"
msgstr "Сводка оценок с отзывом"

msgid "Rating summary card with a Write a Review button for a product."
msgstr "Карточка со сводкой оценок и кнопкой «Написать отзыв» для товара."

msgid "Write a Review"
msgstr "Написать отзыв"

msgid "A button that opens the review submission drawer for a product."
msgstr "Кнопка, которая открывает панель отправки отзыва о товаре."

msgid "You are making payment for your order (#%1$s)."
msgstr "Вы оплачиваете заказ (#%1$s)."

msgid "Order Review Page"
msgstr "Страница отзывов о заказе"

msgid "Invoice Reminders"
msgstr "Напоминания о счетах"

msgid "Send overdue reminders for unpaid renewal orders on manual subscriptions."
msgstr "Отправлять напоминания о неоплаченных заказах на продление по подпискам с ручной оплатой."

msgid "Overdue Invoice Reminders"
msgstr "Напоминания о просроченных счетах"

msgid "Remind customers about unpaid invoices after the due date."
msgstr "Напоминать клиентам о неоплаченных счетах после срока оплаты."

msgid "Days after due date to send overdue reminders. Comma-separated (e.g. 1,3,7). Default: 1,3,7"
msgstr "Через сколько дней после срока оплаты отправлять напоминания. Через запятую (например 1,3,7). По умолчанию: 1,3,7"

msgid "My Reviews"
msgstr "Мои отзывы"

msgid "Install Bricks Addon"
msgstr "Установить дополнение для Bricks"

msgid "Design your store pages with FluentCart elements in Bricks."
msgstr "Оформляйте страницы магазина элементами FluentCart в Bricks."

msgid "Install Elementor Addon"
msgstr "Установить дополнение для Elementor"

msgid "Design your store pages with FluentCart widgets in Elementor."
msgstr "Оформляйте страницы магазина виджетами FluentCart в Elementor."

msgid "Install Divi Addon"
msgstr "Установить дополнение для Divi"

msgid "Design your store pages with FluentCart modules in Divi."
msgstr "Оформляйте страницы магазина модулями FluentCart в Divi."

msgid "Invalid or missing \"template\" parameter."
msgstr "Параметр «template» неверный или отсутствует."

msgid "No storage drivers are enabled. Please enable a storage driver from the storage settings."
msgstr "Не включено ни одного хранилища. Включите хранилище в настройках хранилищ."

msgid "Invalid driver. Available drivers: %1$s"
msgstr "Неверное хранилище. Доступные: %1$s"

msgid "Invalid file path"
msgstr "Неверный путь к файлу"

msgid "Please verify your email before using saved addresses."
msgstr "Подтвердите почту, чтобы пользоваться сохранёнными адресами."

msgid "Unknown portal section group."
msgstr "Неизвестная группа разделов кабинета."

msgid "This subscription cannot be moved to another payment gateway. Update the payment method on file instead."
msgstr "Эту подписку нельзя перевести на другую платёжную систему. Вместо этого обновите сохранённый способ оплаты."

msgid "Payment method switched successfully"
msgstr "Способ оплаты изменён"

msgid "Subscription switch confirmed successfully"
msgstr "Смена подписки подтверждена"

msgid "Paused by customer from customer portal"
msgstr "Приостановлено клиентом из кабинета"

msgid "Your subscription has been successfully paused"
msgstr "Ваша подписка приостановлена"

msgid "Resumed by customer from customer portal"
msgstr "Возобновлено клиентом из кабинета"

msgid "Your subscription has been successfully resumed"
msgstr "Ваша подписка возобновлена"

msgid "Reviews are not available"
msgstr "Отзывы недоступны"

msgid "Rated %1$s out of 5"
msgstr "Оценка %1$s из 5"

msgid "Unable to verify identity."
msgstr "Не удалось подтвердить личность."

msgid "Too many submissions. Please try again later."
msgstr "Слишком много отправок. Попробуйте позже."

msgid "That item is not available for review."
msgstr "Этот товар нельзя оценить."

msgid "Reviews of a specific item are only accepted through the order link that includes it."
msgstr "Отзывы о конкретном товаре принимаются только по ссылке из заказа, в котором он есть."

msgid "Review content is required."
msgstr "Нужен текст отзыва."

msgid "Star rating is required"
msgstr "Нужна оценка звёздами"

msgid "A valid email address is required"
msgstr "Нужен действующий адрес почты"

msgid "You have already submitted a review for this product"
msgstr "Вы уже оставили отзыв об этом товаре"

msgid "A review with this email already exists for this product"
msgstr "Отзыв с этим адресом почты об этом товаре уже есть"

msgid "Thank you for your review!"
msgstr "Спасибо за отзыв!"

msgid "Thank you! Your review has been submitted and is pending approval."
msgstr "Спасибо! Ваш отзыв отправлен и ждёт проверки."

msgid "Session expired. Please refresh and try again."
msgstr "Сессия истекла. Обновите страницу и попробуйте ещё раз."

msgid "You must be logged in to update a review"
msgstr "Чтобы изменить отзыв, нужно войти"

msgid "Reviews are currently disabled"
msgstr "Отзывы сейчас отключены"

msgid "Review not found or you do not have permission to edit it"
msgstr "Отзыв не найден, или у вас нет прав его менять"

msgid "Nothing to update."
msgstr "Нечего обновлять."

msgid "Your review has been updated and is pending approval."
msgstr "Ваш отзыв обновлён и ждёт проверки."

msgid "Your review has been updated!"
msgstr "Ваш отзыв обновлён!"

msgid "Reviews are currently disabled for this product"
msgstr "Отзывы об этом товаре сейчас отключены"

msgid "FluentCart Bricks Blocks"
msgstr "Блоки FluentCart для Bricks"

msgid "Enable to get Bricks Builder elements for FluentCart. Requires the Bricks theme."
msgstr "Включите, чтобы получить элементы FluentCart для Bricks Builder. Нужна тема Bricks."

msgid "FluentCart Divi Modules"
msgstr "Модули FluentCart для Divi"

msgid "Native Divi 5 modules for FluentCart products, cart, and checkout. Requires Divi 5.0+ and FluentCart 1.3.4+."
msgstr "Родные модули Divi 5 для товаров, корзины и оформления заказа FluentCart. Нужны Divi 5.0+ и FluentCart 1.3.4+."

msgid "Subscription product cannot be placed as a one time item."
msgstr "Товар с подпиской нельзя добавить как разовую позицию."

msgid "One time product cannot be placed as a subscription item."
msgstr "Разовый товар нельзя добавить как позицию подписки."

msgid "One time product cannot be placed as a fee item."
msgstr "Разовый товар нельзя добавить как сбор."

msgid "Subscription product must be placed as a subscription item."
msgstr "Товар с подпиской нужно добавить как позицию подписки."

msgid "Custom item has been added to the order!"
msgstr "Своя позиция добавлена в заказ!"

msgid "Payment note"
msgstr "Примечание к платежу"

msgid "A succeeded transaction cannot be changed here. Use the refund action to return the payment."
msgstr "Успешную транзакцию здесь изменить нельзя. Чтобы вернуть платёж, используйте возврат."

msgid "Transaction has been synced from the payment gateway successfully!"
msgstr "Транзакция синхронизирована с платёжной системой!"

msgid "Stock Management module is disabled. Enable it from Settings to manage inventory."
msgstr "Модуль управления запасами отключён. Включите его в настройках, чтобы вести остатки."

msgid "Please select a variation that belongs to this product."

msgstr "У этого отзыва уже есть ответ. Удалите его, чтобы написать новый."

msgid "Could not save the reply. Please try again."
msgstr "Не удалось сохранить ответ. Попробуйте ещё раз."

msgid "Your reply has been submitted successfully."
msgstr "Ваш ответ отправлен."

msgid "Reply not found"
msgstr "Ответ не найден"

msgid "Reply deleted successfully"
msgstr "Ответ удалён"

msgid "A valid billing interval is required for subscription variants."
msgstr "Для вариантов с подпиской нужен корректный интервал выставления счёта."

msgid "for %1$s Times"
msgstr "на %1$s раз"

msgid "Renewal order not found"
msgstr "Заказ на продление не найден"

msgid "Back to Orders"
msgstr "Назад к заказам"

msgid "Only renewal orders can be voided"
msgstr "Аннулировать можно только заказы на продление"

msgid "Only pending or scheduled invoices can be voided"
msgstr "Аннулировать можно только ожидающие или запланированные счета"

msgid "This invoice was just paid and can no longer be voided"
msgstr "Этот счёт только что оплачен, и аннулировать его уже нельзя"

msgid "Renewal order has been voided successfully"
msgstr "Заказ на продление аннулирован"

msgid "Only renewal orders can be resent"
msgstr "Повторно отправить можно только заказы на продление"

msgid "Only pending renewal orders can be resent"
msgstr "Повторно отправить можно только ожидающие заказы на продление"

msgid "This invoice is still being retried automatically. Resend is available once retries are exhausted."
msgstr "Этот счёт ещё оплачивается автоматическими повторными попытками. Повторная отправка станет доступна, когда попытки закончатся."

msgid "Renewal order email has been resent"
msgstr "Письмо о заказе на продление отправлено повторно"

msgid "Comparing products is only available in FluentCart Pro."
msgstr "Сравнение товаров доступно только в FluentCart Pro."

msgid "Max spend amount must be greater than or equal to min spend amount."
msgstr "Максимальная сумма покупки должна быть не меньше минимальной."

msgid "The start date must be a valid date string."
msgstr "Дата начала должна быть корректной строкой даты."

msgid "The end date must be a valid date string."
msgstr "Дата окончания должна быть корректной строкой даты."

msgid "Rating must be a number."
msgstr "Оценка должна быть числом."

msgid "Rating must be at least 1."
msgstr "Оценка должна быть не меньше 1."

msgid "Rating must not exceed 5."
msgstr "Оценка должна быть не больше 5."

msgid "Review title must not exceed 192 characters."
msgstr "Заголовок отзыва не длиннее 192 символов."

msgid "Review content must not exceed 5000 characters."
msgstr "Текст отзыва не длиннее 5000 символов."

msgid "The applied coupon \"%1$s\" is missing its coupon id."
msgstr "У применённого купона «%1$s» нет идентификатора."

msgid "Setup Fee option is required."
msgstr "Нужно выбрать вариант платы за настройку."

msgid "Stock quantity must be a number."
msgstr "Количество на складе должно быть числом."

msgid "Stock quantity is required when inventory tracking is on."
msgstr "Когда учёт запасов включён, нужно указать количество на складе."

msgid "Available quantity is required when inventory tracking is on."
msgstr "Когда учёт запасов включён, нужно указать доступное количество."

msgid "Please select a product for this review."
msgstr "Выберите товар для этого отзыва."

msgid "Please select a valid variation for this review."
msgstr "Выберите корректную вариацию для этого отзыва."

msgid "Reviewer name is required."
msgstr "Нужно указать имя автора отзыва."

msgid "Reviewer name must not exceed 100 characters."
msgstr "Имя автора отзыва не длиннее 100 символов."

msgid "Email address must not exceed 192 characters."
msgstr "Адрес почты не длиннее 192 символов."

msgid "Rating must be at least 0."
msgstr "Оценка должна быть не меньше 0."

msgid "Reviews per page must not exceed 150."
msgstr "Отзывов на странице не больше 150."

msgid "Invalid subscription status."
msgstr "Недопустимый статус подписки."

msgid "Invalid date format for next billing date."
msgstr "Неверный формат даты следующего списания."

msgid "Recurring total must be a number."
msgstr "Регулярная сумма должна быть числом."

msgid "Recurring total cannot be negative."
msgstr "Регулярная сумма не может быть отрицательной."

msgid "Bill times must be a number."
msgstr "Число списаний должно быть числом."

msgid "Bill times cannot be negative."
msgstr "Число списаний не может быть отрицательным."

msgid "Subscription status is required."
msgstr "Нужно указать статус подписки."

msgid "Vendor IDs may only contain letters, numbers, dots, dashes and underscores."
msgstr "Идентификаторы платёжной системы могут содержать только латинские буквы, цифры, точки, дефисы и подчёркивания."

msgid "Vendor Subscription ID cannot be longer than 45 characters."
msgstr "ID подписки в платёжной системе не длиннее 45 символов."

msgid "Vendor Customer ID cannot be longer than 45 characters."
msgstr "ID клиента в платёжной системе не длиннее 45 символов."

msgid "User creation failed: %1$s"
msgstr "Не удалось создать пользователя: %1$s"

msgid "User account has been created automatically on payment success. Created User ID: %1$s"
msgstr "Аккаунт пользователя создан автоматически после успешной оплаты. ID пользователя: %1$s"

msgid "Renewal Payment Failed"
msgstr "Оплата продления не прошла"

msgid "Automatic renewal charge failed: %1$s"
msgstr "Автоматическое списание за продление не прошло: %1$s"

msgid "This product is no longer available."
msgstr "Этот товар больше недоступен."

msgid "Only charge transactions can be synced from the payment gateway."
msgstr "Синхронизировать с платёжной системой можно только транзакции списания."

msgid "Only pending transactions can be synced from the payment gateway."
msgstr "Синхронизировать с платёжной системой можно только ожидающие транзакции."

msgid "This transaction has no gateway charge ID to sync against."
msgstr "У этой транзакции нет ID списания в платёжной системе для синхронизации."

msgid "This payment method does not support remote transaction sync"
msgstr "Этот способ оплаты не поддерживает синхронизацию транзакций"

msgid "Enjoying FluentCart? %1$sTell us what you think%2$s"
msgstr "Нравится FluentCart? %1$sРасскажите, что вы думаете%2$s"

msgid "Pro %s"
msgstr "Pro %s"

msgid "Play video: %1$s"
msgstr "Смотреть видео: %1$s"

msgid "Paid Purchases"
msgstr "Оплаченные покупки"

msgid "First Paid Order"
msgstr "Первый оплаченный заказ"

msgid "Last Paid Order"
msgstr "Последний оплаченный заказ"

msgid "Recent purchases"
msgstr "Недавние покупки"

msgid "Unknown integration provider."
msgstr "Неизвестный поставщик интеграции."

msgid "Payment in %s is not available. Please start your purchase again."
msgstr "Оплата в %s недоступна. Начните покупку заново."

msgid "Your currency changed to %s. Please review your order total before paying."
msgstr "Ваша валюта изменилась на %s. Проверьте сумму заказа перед оплатой."

msgid "Prices were updated to today's exchange rate. Please review your order total before paying."
msgstr "Цены пересчитаны по сегодняшнему курсу. Проверьте сумму заказа перед оплатой."

msgid "Transaction currency differs from the order currency"
msgstr "Валюта транзакции отличается от валюты заказа"

msgid "A %1$s transaction was recorded on a %2$s order. Every amount on an order is in its own currency, so this payment needs review."
msgstr "Транзакция в %1$s записана к заказу в %2$s. Все суммы заказа ведутся в его собственной валюте, поэтому этот платёж нужно проверить."

msgid "Enter rates manually"
msgstr "Вводить курсы вручную"

msgid "These currencies cannot be enabled: %1$s. A presentment currency must be a supported currency, different from the base currency, and not a three-decimal currency."
msgstr "Эти валюты нельзя включить: %1$s. Валюта показа должна поддерживаться, отличаться от базовой и не иметь трёх знаков после запятой."

msgid "The store currency is the base currency every exchange rate and report is measured in, so it cannot be changed while multi-currency is enabled and orders exist."
msgstr "Валюта магазина служит базовой, в ней считаются все курсы и отчёты, поэтому её нельзя менять, пока включена мультивалютность и есть заказы."

msgid "Round to the smallest unit of the currency"
msgstr "Округлять до наименьшей единицы валюты"

msgid "Round up to %1$s"
msgstr "Округлять вверх до %1$s"

msgid "No charm pricing"
msgstr "Без «красивых» цен"

msgid "End in .99 (take off 0.01)"
msgstr "Заканчивать на .99 (минус 0.01)"

msgid "End in .95 (take off 0.05)"
msgstr "Заканчивать на .95 (минус 0.05)"

msgid "This payment method cannot charge saved payment methods."
msgstr "Этот способ оплаты не умеет списывать с сохранённых способов оплаты."

msgid "This payment method cannot reconcile pending charges."
msgstr "Этот способ оплаты не умеет сверять ожидающие списания."

msgid "Remote transaction sync is not available for this payment method."
msgstr "Синхронизация транзакций недоступна для этого способа оплаты."

msgid "Vendor subscription lookup is not implemented for this payment method."
msgstr "Поиск подписки в платёжной системе не реализован для этого способа оплаты."

msgid "Could not generate a PayPal id token."
msgstr "Не удалось получить токен PayPal."

msgid "- Billing subscription activated | Billing subscription cancelled | Billing subscription created | Billing subscription expired | Billing subscription suspended | Billing subscription payment failed"
msgstr "- Подписка активирована | Подписка отменена | Подписка создана | Подписка истекла | Подписка приостановлена | Платёж по подписке не прошёл"

msgid "Invalid PayPal connection request."
msgstr "Неверный запрос на подключение PayPal."

msgid "You do not have permission to configure PayPal."
msgstr "У вас нет прав настраивать PayPal."

msgid "Invalid PayPal payment mode."
msgstr "Неверный режим оплаты PayPal."

msgid "Security check failed. Please try connecting PayPal again."
msgstr "Проверка безопасности не пройдена. Попробуйте подключить PayPal ещё раз."

msgid "Payment currency mismatch detected. Expected: %1$s, Received: %2$s. Transaction: %3$s. Subscription not confirmed."
msgstr "Обнаружено несовпадение валюты платежа. Ожидалось: %1$s, получено: %2$s. Транзакция: %3$s. Подписка не подтверждена."

msgid "Payment amount mismatch detected. Expected: %1$s, Received: %2$s. Transaction: %3$s. Subscription not confirmed."
msgstr "Обнаружено несовпадение суммы платежа. Ожидалось: %1$s, получено: %2$s. Транзакция: %3$s. Подписка не подтверждена."

msgid "PayPal Subscription Activation Skipped"
msgstr "Активация подписки PayPal пропущена"

msgid "Could not fetch PayPal subscription resource to activate. Subscription: %1$s, Vendor Subscription ID: %2$s."
msgstr "Не удалось получить подписку PayPal для активации. Подписка: %1$s, ID подписки в платёжной системе: %2$s."

msgid "PayPal reported a failed subscription payment (failed attempts: %d)."
msgstr "PayPal сообщил о неудачном платеже по подписке (неудачных попыток: %d)."

msgid "PayPal reported a failed subscription payment."
msgstr "PayPal сообщил о неудачном платеже по подписке."

msgid "Could not fetch the PayPal subscription to confirm this payment."
msgstr "Не удалось получить подписку PayPal, чтобы подтвердить этот платёж."

msgid "The incoming sale is not yet on the PayPal transaction list."
msgstr "Входящей продажи ещё нет в списке транзакций PayPal."

msgid "PayPal renewal resync retries exhausted — needs manual review"
msgstr "Повторные попытки синхронизировать продление PayPal исчерпаны, нужна ручная проверка"

msgid "All scheduled resync retries failed. Subscription ID: %1$d. Unresolved PayPal sales: %2$s"
msgstr "Все запланированные повторные синхронизации не удались. ID подписки: %1$d. Неразобранные продажи PayPal: %2$s"

msgid "none recorded"
msgstr "не записано"

msgid "PayPal renewal payment could not be recorded — needs manual review"
msgstr "Не удалось записать платёж за продление PayPal, нужна ручная проверка"

msgid "%1$s Subscription ID: %2$d"
msgstr "%1$s ID подписки: %2$d"

msgid "Subscription is not manual or does not exist"
msgstr "Подписка не ручная или не существует"

msgid "Cannot convert completed subscriptions"
msgstr "Завершённые подписки нельзя преобразовать"

msgid "Your payment is being reviewed by PayPal. Your order will be confirmed once the payment is completed."
msgstr "PayPal проверяет ваш платёж. Заказ будет подтверждён, как только платёж завершится."

msgid "No setup token!"
msgstr "Нет токена настройки!"

msgid "Setup token does not match this transaction!"
msgstr "Токен настройки не соответствует этой транзакции!"

msgid "This PayPal approval is no longer valid. Please try again."
msgstr "Это подтверждение PayPal больше не действует. Попробуйте ещё раз."

msgid "Your PayPal account has been saved successfully! Redirecting..."
msgstr "Ваш аккаунт PayPal сохранён! Перенаправляем…"

msgid "PayPal Payment Pending"
msgstr "Платёж PayPal ожидает"

msgid "PayPal placed this payment on hold and no money has moved yet. Capture: %1$s, Reason: %2$s. The order stays unpaid until the PAYMENT.CAPTURE.COMPLETED webhook arrives."
msgstr "PayPal задержал этот платёж, деньги ещё не списаны. Списание: %1$s, причина: %2$s. Заказ остаётся неоплаченным, пока не придёт вебхук PAYMENT.CAPTURE.COMPLETED."

msgid "Brand name"
msgstr "Название бренда"

msgid "Shown on the PayPal checkout instead of your business name"
msgstr "Показывается при оплате через PayPal вместо названия вашей компании"

msgid "Optional. Up to 127 characters. Leave empty to show the name on your PayPal business account."
msgstr "Необязательно. До 127 символов. Оставьте пустым, чтобы показывать название вашего бизнес-аккаунта PayPal."

msgid "PayPal is temporarily unavailable for this checkout. Please choose another payment method or try again later."
msgstr "PayPal временно недоступен для этой оплаты. Выберите другой способ оплаты или попробуйте позже."

msgid "Your payment is being reviewed. We will confirm your order once it completes."
msgstr "Ваш платёж проверяется. Мы подтвердим заказ, как только он завершится."

msgid "Your PayPal account will be saved securely and charged automatically on each renewal date. You can cancel any time from your account."
msgstr "Ваш аккаунт PayPal будет надёжно сохранён, и в каждую дату продления оплата будет списываться автоматически. Отменить можно в любой момент в кабинете."

msgid "A Vendor Subscription ID is required to look up a PayPal subscription."
msgstr "Для поиска подписки PayPal нужен ID подписки в платёжной системе."

msgid "The subscription's parent order no longer exists."
msgstr "Исходного заказа этой подписки больше не существует."

msgid "PayPal renewal amount exceeds the cycle price"
msgstr "Сумма продления PayPal больше цены периода"

msgid "PayPal sale %1$s charged %2$d against a cycle price of %3$d — not an exact cycle multiple, so no extra cycles were credited. Review the subscription's billing history manually."
msgstr "Продажа PayPal %1$s списала %2$d при цене периода %3$d. Это не кратно цене периода, поэтому дополнительные периоды не засчитаны. Проверьте историю списаний подписки вручную."

msgid "PayPal outstanding credit deferred — lock timeout"
msgstr "Зачёт задолженности PayPal отложен: истекло ожидание блокировки"

msgid "Could not acquire the billing-history lock while crediting PayPal sale %s; the payment was left unrecorded so a redelivery or scheduled resync can credit and record it together."
msgstr "Не удалось получить блокировку истории списаний при зачёте продажи PayPal %s. Платёж оставлен незаписанным, чтобы повторная доставка или запланированная синхронизация зачла и записала его вместе."

msgid "Could not acquire the billing-history lock to credit this collection."
msgstr "Не удалось получить блокировку истории списаний для зачёта этой оплаты."

msgid "PayPal outstanding balance collected"
msgstr "Задолженность PayPal погашена"

msgid "PayPal sale %1$s collected the outstanding balance of previously missed cycles — one payment covering %2$d billing cycles. The extra cycles were credited to the local bill count."
msgstr "Продажа PayPal %1$s погасила задолженность за пропущенные ранее периоды: один платёж покрыл %2$d периодов. Дополнительные периоды засчитаны в местный счётчик списаний."

msgid "PayPal outstanding credit revoked"
msgstr "Зачёт задолженности PayPal отменён"

msgid "The outstanding-collection credit for PayPal sale %1$s was revoked because the renewal recording it backed failed. The retry or redelivery that finally records the sale will credit it again."
msgstr "Зачёт задолженности по продаже PayPal %1$s отменён, потому что не удалось записать связанное с ним продление. Повторная попытка или доставка, которая в итоге запишет продажу, зачтёт её снова."

msgid "PayPal outstanding credit backfilled"
msgstr "Зачёт задолженности PayPal добавлен задним числом"

msgid "A resync found PayPal sale %1$s already recorded with a multi-cycle gross but no outstanding-collection credit — the credit was added retroactively and the bill count resynced."
msgstr "Синхронизация нашла продажу PayPal %1$s уже записанной с суммой за несколько периодов, но без зачёта задолженности. Зачёт добавлен задним числом, счётчик списаний синхронизирован."

msgid "Subscription resumed."
msgstr "Подписка возобновлена."

msgid "Subscription resumed via PayPal"
msgstr "Подписка возобновлена через PayPal"

msgid "PayPal did not return a setup token."
msgstr "PayPal не вернул токен настройки."

msgid "Another payment confirmation is in progress. Please try again."
msgstr "Уже идёт подтверждение другого платежа. Попробуйте ещё раз."

msgid "No auto-charged subscription is attached to this transaction."
msgstr "К этой транзакции не привязана подписка с автосписанием."

msgid "PayPal did not return a saved payment method."
msgstr "PayPal не вернул сохранённый способ оплаты."

msgid "PayPal payment method vaulted for automatic renewal charges."
msgstr "Способ оплаты PayPal сохранён для автоматических списаний за продление."

msgid "Subscription initial payment mismatch. Expected: %1$s %2$s, Received: %3$s %4$s. Order not marked paid; awaiting webhook."
msgstr "Первый платёж по подписке не совпадает. Ожидалось: %1$s %2$s, получено: %3$s %4$s. Заказ не отмечен оплаченным, ждём вебхук."

msgid "PayPal did not return a saved payment method for automatic charging."
msgstr "PayPal не вернул сохранённый способ оплаты для автоматических списаний."

msgid "Renewal invoice is missing its order, transaction, or subscription."
msgstr "У счёта на продление нет заказа, транзакции или подписки."

msgid "No saved PayPal payment method is available for this subscription."
msgstr "Для этой подписки нет сохранённого способа оплаты PayPal."

msgid "No transaction is recorded for this renewal order."
msgstr "Для этого заказа на продление не записано ни одной транзакции."

msgid "The pending PayPal payment could not be completed (status: %1$s)."
msgstr "Ожидающий платёж PayPal не удалось завершить (статус: %1$s)."

msgid "No PayPal charge is recorded for this renewal order."
msgstr "Для этого заказа на продление не записано списание PayPal."

msgid "PayPal Currency Mismatch On Sync"
msgstr "Несовпадение валюты PayPal при синхронизации"

msgid "Capture currency mismatch detected during transaction sync. Expected: %1$s, Received: %2$s. Transaction was not confirmed."
msgstr "При синхронизации транзакции обнаружено несовпадение валюты списания. Ожидалось: %1$s, получено: %2$s. Транзакция не подтверждена."

msgid "The PayPal payment currency does not match this transaction. Please verify the payment at PayPal."
msgstr "Валюта платежа PayPal не совпадает с этой транзакцией. Проверьте платёж в PayPal."

msgid "PayPal Amount Mismatch On Sync"
msgstr "Несовпадение суммы PayPal при синхронизации"

msgid "Capture amount mismatch detected during transaction sync. Expected: %1$s, Received: %2$s. Transaction was not confirmed."
msgstr "При синхронизации транзакции обнаружено несовпадение суммы списания. Ожидалось: %1$s, получено: %2$s. Транзакция не подтверждена."

msgid "The PayPal payment amount does not match this transaction. Please verify the payment at PayPal."
msgstr "Сумма платежа PayPal не совпадает с этой транзакцией. Проверьте платёж в PayPal."

msgid "The payment is still pending at PayPal (reason: %1$s). Please try again later."
msgstr "Платёж в PayPal всё ещё ожидает (причина: %1$s). Попробуйте позже."

msgid "The PayPal payment could not be completed (status: %1$s)."
msgstr "Платёж PayPal не удалось завершить (статус: %1$s)."

msgid "Automatic PayPal charge failed: %1$s"
msgstr "Автоматическое списание PayPal не прошло: %1$s"

msgid "Automatic PayPal charge could not be completed (status: %1$s)."
msgstr "Автоматическое списание PayPal не удалось завершить (статус: %1$s)."

msgid "Pay securely with Airwallex - Global payment processing with Drop-in Element for onsite checkout"
msgstr "Безопасная оплата через Airwallex: глобальный приём платежей с формой Drop-in прямо на странице оформления"

msgid "Airwallex Payment Gateway"
msgstr "Платёжная система Airwallex"

msgid "Accept global payments with Airwallex - Cards, Apple Pay, Google Pay, and more. Onsite checkout with no redirect."
msgstr "Принимайте платежи со всего мира через Airwallex: карты, Apple Pay, Google Pay и другие. Оплата на странице, без перенаправления."

msgid "Onsite checkout - no redirect"
msgstr "Оплата на странице, без перенаправления"

msgid "Global payment processing"
msgstr "Глобальный приём платежей"

msgid "Pay securely with Flutterwave - Card, Bank Transfer, Mobile Money, and more"
msgstr "Безопасная оплата через Flutterwave: карта, банковский перевод, мобильные деньги и другое"

msgid "Pay securely with Mercado Pago - Cards, Pix, Boleto, OXXO, and more"
msgstr "Безопасная оплата через Mercado Pago: карты, Pix, Boleto, OXXO и другое"

msgid "Pay securely with Paystack - Cards, Bank Transfer, USSD, and Mobile Money"
msgstr "Безопасная оплата через Paystack: карты, банковский перевод, USSD и мобильные деньги"

msgid "Pay securely with Razorpay - UPI, Cards, NetBanking, and Wallets"
msgstr "Безопасная оплата через Razorpay: UPI, карты, интернет-банк и кошельки"

msgid "Pay securely with Authorize.Net - Credit and Debit Cards"
msgstr "Безопасная оплата через Authorize.Net: кредитные и дебетовые карты"

msgid "Pay securely with Mollie - Credit Card, PayPal, SEPA, and more."
msgstr "Безопасная оплата через Mollie: кредитная карта, PayPal, SEPA и другое."

msgid "Accept credit cards and PayPal payments securely with Paddle. Available in FluentCart Pro."
msgstr "Безопасно принимайте карты и PayPal через Paddle. Доступно в FluentCart Pro."

msgid "Stripe API key is not configured for this payment mode. Please add your Stripe keys in Payment Settings."
msgstr "Ключ API Stripe не настроен для этого режима оплаты. Добавьте ключи Stripe в настройках оплаты."

msgid "Stripe Payment Intent Retrieval Failed"
msgstr "Не удалось получить платёжное намерение Stripe"

msgid "Stripe 3D Secure Authentication Not Completed"
msgstr "Проверка 3D Secure в Stripe не завершена"

msgid "Stripe Payment Not Completed"
msgstr "Платёж Stripe не завершён"

msgid "Stripe reported the payment intent as %1$s. %2$s"
msgstr "Stripe сообщил статус платёжного намерения: %1$s. %2$s"

msgid "Stripe 3D Secure Authentication Failed"
msgstr "Проверка 3D Secure в Stripe не пройдена"

msgid "Stripe Payment Failed"
msgstr "Платёж Stripe не прошёл"

msgid "Your payment is still being processed by Stripe. Please do not submit it again — we will confirm your order as soon as it settles."
msgstr "Stripe ещё обрабатывает ваш платёж. Не отправляйте его повторно: мы подтвердим заказ, как только он пройдёт."

msgid "The payment could not be completed. Please try again."
msgstr "Не удалось завершить платёж. Попробуйте ещё раз."

msgid "Stripe Payment Method Setup Not Completed"
msgstr "Настройка способа оплаты Stripe не завершена"

msgid "Stripe did not return a saved payment method for automatic charging."
msgstr "Stripe не вернул сохранённый способ оплаты для автоматических списаний."

msgid "Stripe Currency Mismatch On Sync"
msgstr "Несовпадение валюты Stripe при синхронизации"

msgid "Charge currency mismatch detected during transaction sync. Expected: %1$s, Received: %2$s. Transaction was not confirmed."
msgstr "При синхронизации транзакции обнаружено несовпадение валюты списания. Ожидалось: %1$s, получено: %2$s. Транзакция не подтверждена."

msgid "The Stripe payment currency does not match this transaction. Please verify the payment at Stripe."
msgstr "Валюта платежа Stripe не совпадает с этой транзакцией. Проверьте платёж в Stripe."

msgid "The payment is still processing at Stripe. Please try again later."
msgstr "Stripe ещё обрабатывает платёж. Попробуйте позже."

msgid "The payment has not completed at Stripe (status: %1$s)."
msgstr "Платёж в Stripe не завершён (статус: %1$s)."

msgid "Subscription is already active. Please refresh this page to see the status instead of trying again."
msgstr "Подписка уже активна. Обновите страницу, чтобы увидеть статус, вместо повторной попытки."

msgid "We could not update your previous subscription attempt. Please wait a moment and try again."
msgstr "Не удалось обновить вашу предыдущую попытку оформить подписку. Подождите немного и попробуйте ещё раз."

msgid "We could not verify your previous payment attempt. Please wait a moment and try again."
msgstr "Не удалось проверить вашу предыдущую попытку оплаты. Подождите немного и попробуйте ещё раз."

msgid "Your payment has already been processed. Redirecting to your order..."
msgstr "Ваш платёж уже обработан. Переходим к заказу…"

msgid "Your previous payment attempt is still being processed. Please wait a moment before trying again — do not resubmit."
msgstr "Ваша предыдущая попытка оплаты ещё обрабатывается. Подождите немного и не отправляйте её повторно."

msgid "We could not update your previous payment attempt. Please wait a moment and try again."
msgstr "Не удалось обновить вашу предыдущую попытку оплаты. Подождите немного и попробуйте ещё раз."

msgid "Please agree to save your payment method for automatic renewal charges to start this subscription."
msgstr "Чтобы оформить подписку, согласитесь сохранить способ оплаты для автоматических списаний за продление."

msgid "Adjustment"
msgstr "Корректировка"

msgid "Taxes & adjustments"
msgstr "Налоги и корректировки"

msgid "First payment"
msgstr "Первый платёж"

msgid "First payment adjustment"
msgstr "Корректировка первого платежа"

msgid "%1$s is a three-decimal currency and is not supported for payment processing."
msgstr "%1$s имеет три знака после запятой и не поддерживается для приёма платежей."

msgid "No saved payment method is available for this subscription."
msgstr "Для этой подписки нет сохранённого способа оплаты."

msgid "Automatic charge could not be completed (status: %1$s)."
msgstr "Автоматическое списание не удалось завершить (статус: %1$s)."

msgid "No payment intent is recorded for this renewal order."
msgstr "Для этого заказа на продление не записано платёжное намерение."

msgid "The pending payment could not be completed (status: %1$s)."
msgstr "Ожидающий платёж не удалось завершить (статус: %1$s)."

msgid "This subscription was created in %1$s mode, but no Stripe %1$s secret key is configured for this store. Add the matching Stripe keys in Payment Settings to charge the saved payment method."
msgstr "Эта подписка создана в режиме %1$s, но секретный ключ Stripe для режима %1$s в магазине не настроен. Добавьте подходящие ключи Stripe в настройках оплаты, чтобы списывать с сохранённого способа оплаты."

msgid "We could not record that failed attempt. Please reload the page before trying again."
msgstr "Не удалось записать неудачную попытку. Обновите страницу перед повторной попыткой."

msgid "We could not verify your payment status. Please do not pay again. Contact the store to check your order status."
msgstr "Не удалось проверить статус платежа. Не платите повторно. Свяжитесь с магазином, чтобы уточнить статус заказа."

msgid "Submit Button Label"
msgstr "Надпись на кнопке оплаты"

msgid "Automatic (Pay / Subscribe)"
msgstr "Автоматически (Оплатить / Подписаться)"

msgid "Pay"
msgstr "Оплатить"

msgid "Book"
msgstr "Забронировать"

msgid "Donate"
msgstr "Пожертвовать"

msgid "Subscribe"
msgstr "Подписаться"

msgid "Stripe customises the submit button and surrounding copy from this. Applies to Stripe Hosted Checkout only."
msgstr "По этому значению Stripe подбирает надпись на кнопке и текст вокруг неё. Действует только для Stripe Hosted Checkout."

msgid "Applies to Stripe Hosted Checkout only, and is ignored when a card is being saved without a charge. Automatic gives one-time orders the \"Buy\" button and subscriptions the \"Subscribe\" button."
msgstr "Действует только для Stripe Hosted Checkout и не учитывается, когда карта сохраняется без списания. «Автоматически» даёт разовым заказам кнопку «Купить», а подпискам кнопку «Подписаться»."

msgid "Your payment method will be saved securely and charged automatically on each renewal date. You can update or replace it any time from your account."
msgstr "Ваш способ оплаты будет надёжно сохранён, и в каждую дату продления оплата будет списываться автоматически. Обновить или заменить его можно в любой момент в кабинете."

msgid "Refund amount must use the smallest unit of the transaction currency."
msgstr "Сумма возврата должна быть указана в наименьших единицах валюты транзакции."

msgid "A Vendor Subscription ID is required to look up a Stripe subscription."
msgstr "Для поиска подписки Stripe нужен ID подписки в платёжной системе."

msgid "This subscription has no vendor subscription to update."
msgstr "У этой подписки нет подписки в платёжной системе, которую можно обновить."

msgid "This subscription has no saved payment profile to update."
msgstr "У этой подписки нет сохранённого платёжного профиля, который можно обновить."

msgid "The saved payment method for automatic renewal charges was updated by the customer."
msgstr "Клиент обновил сохранённый способ оплаты для автоматических списаний за продление."

msgid "Stripe reported a failed invoice payment attempt."
msgstr "Stripe сообщил о неудачной попытке оплаты счёта."

msgid "Event resolved to no order."
msgstr "Событие не привязано ни к одному заказу."

msgid "Event type has no order resolver."
msgstr "Для этого типа события нет обработчика заказа."

msgid "Setup intent could not be confirmed."
msgstr "Не удалось подтвердить намерение настройки."

msgid "Subscription renewal invoice resolved to no order."
msgstr "Счёт за продление подписки не привязан ни к одному заказу."

msgid "Subscription renewal-failure invoice resolved to no order."
msgstr "Счёт о неудачном продлении подписки не привязан ни к одному заказу."

msgid "Subscription matched but its parent order is missing."
msgstr "Подписка найдена, но её исходного заказа нет."

msgid "No local transaction matches the disputed charge."
msgstr "Ни одна местная транзакция не совпадает с оспоренным списанием."

msgid "Checkout session does not match a local order."
msgstr "Сессия оформления не совпадает ни с одним местным заказом."

msgid "Event references an order that does not exist here."
msgstr "Событие ссылается на заказ, которого здесь нет."

msgid "Event carries no reference to a local order."
msgstr "Событие не содержит ссылки на местный заказ."

msgid "↳ Reviews"
msgstr "↳ Отзывы"

msgid "Renewal skipped — this subscription is in %1$s mode but the store is currently in %2$s mode."
msgstr "Продление пропущено: подписка в режиме %1$s, а магазин сейчас в режиме %2$s."

msgid "Original order item not found for this subscription."
msgstr "Исходная позиция заказа для этой подписки не найдена."

msgid "Renewal creation already in progress for this subscription."
msgstr "Продление по этой подписке уже создаётся."

msgid "Failed to create child order for subscription renewal."
msgstr "Не удалось создать дочерний заказ для продления подписки."

msgid "Failed to create order item for renewal order."
msgstr "Не удалось создать позицию заказа на продление."

msgid "Failed to create transaction record for renewal order."
msgstr "Не удалось создать запись транзакции для заказа на продление."

msgid "Subscription does not belong to this order."
msgstr "Подписка не относится к этому заказу."

msgid "This subscription is already canceled, completed, or expired."
msgstr "Эта подписка уже отменена, завершена или истекла."

msgid "Only store-billed (manual or auto-charge) subscriptions can be reactivated."
msgstr "Возобновить можно только подписки с оплатой через магазин (вручную или автосписанием)."

msgid "Subscription has been reactivated successfully!"
msgstr "Подписка возобновлена!"

msgid "Paused by admin"
msgstr "Приостановлено администратором"

msgid "Subscription has been paused successfully!"
msgstr "Подписка приостановлена!"

msgid "Resumed by admin"
msgstr "Возобновлено администратором"

msgid "Subscription has been resumed successfully!"
msgstr "Подписка возобновлена!"

msgid "Only manual subscriptions can be updated."
msgstr "Изменять можно только подписки с ручной оплатой."

msgid "No data provided for update."
msgstr "Нет данных для обновления."

msgid "Subscription has been updated successfully!"
msgstr "Подписка обновлена!"

msgid "Vendor IDs have been updated successfully!"
msgstr "Идентификаторы платёжной системы обновлены!"

msgid "Vendor IDs can only be edited on an active gateway-billed subscription."
msgstr "Идентификаторы платёжной системы можно менять только у активной подписки, которую оплачивает платёжная система."

msgid "This payment method does not support subscription lookup."
msgstr "Этот способ оплаты не поддерживает поиск подписок."

msgid "Subscription found at the payment gateway."
msgstr "Подписка найдена в платёжной системе."

msgid "There is no open renewal order to charge for this subscription."
msgstr "По этой подписке нет открытого заказа на продление для списания."

msgid "Creating a renewal is only available for store-billed (manual or auto-charge) subscriptions."
msgstr "Создать продление можно только для подписок с оплатой через магазин (вручную или автосписанием)."

msgid "A renewal can only be created for active or trialing subscriptions."
msgstr "Продление можно создать только для активной подписки или подписки в пробном периоде."

msgid "Subscription has no upcoming billing date."
msgstr "У подписки нет предстоящей даты списания."

msgid "A pending renewal already exists for this subscription."
msgstr "По этой подписке уже есть ожидающее продление."

msgid "A renewal already exists but is not open for charging."
msgstr "Продление уже есть, но оно не открыто для списания."

msgid "Renewal has been created successfully."
msgstr "Продление создано."

msgid "Skip next period is only available for store-billed (manual or auto-charge) subscriptions."
msgstr "Пропустить следующий период можно только для подписок с оплатой через магазин (вручную или автосписанием)."

msgid "Period can only be skipped for active or trialing subscriptions."
msgstr "Пропустить период можно только у активной подписки или подписки в пробном периоде."

msgid "Subscription has no upcoming billing date to skip."
msgstr "У подписки нет предстоящей даты списания, которую можно пропустить."

msgid "The next period could not be skipped. It may have already been skipped."
msgstr "Не удалось пропустить следующий период. Возможно, он уже пропущен."

msgid "Billing period has been skipped successfully."
msgstr "Платёжный период пропущен."

msgid "No payment is due today. Future payments for your subscription will be collected using the payment method you select."
msgstr "Сегодня платить ничего не нужно. Будущие платежи по подписке будут списываться выбранным способом оплаты."

msgid "the first payment of this subscription is zero and they cannot process a zero-amount checkout"
msgstr "первый платёж по этой подписке нулевой, а они не умеют проводить оформление на нулевую сумму"

msgid "they don't yet support taking a subscription's first payment as a plain one-time charge under store-managed billing"
msgstr "они пока не умеют принимать первый платёж по подписке как обычное разовое списание при оплате через магазин"

msgid "they create their own subscription schedule, which would bill alongside the renewals FluentCart generates"
msgstr "они создают собственное расписание подписки, которое списывало бы деньги вдобавок к продлениям, создаваемым FluentCart"

msgid "Enable Automatic Charge in the subscription settings and use a gateway that can save a payment method without charging it, or keep offline methods active."
msgstr "Включите «Автоматическое списание» в настройках подписок и используйте платёжную систему, которая умеет сохранять способ оплаты без списания, или оставьте активными офлайн-способы."

msgid "These payment methods do not yet support store-managed billing."
msgstr "Эти способы оплаты пока не поддерживают оплату подписок через магазин."

msgid "Under gateway-managed billing, only gateways with native subscription support can appear here. Enable Manual Fallback in the subscription settings to also allow non-subscription gateways (including offline methods) to fall back to manual billing."
msgstr "Когда подписки оплачиваются через платёжную систему, здесь показываются только системы со встроенной поддержкой подписок. Включите «Ручной запасной вариант» в настройках подписок, чтобы системы без подписок (включая офлайн-способы) могли переходить на ручную оплату."

msgid "Admin note (only visible to you): %1$s hidden because %2$s. %3$s"
msgstr "Заметка администратора (видна только вам): %1$s скрыто, потому что %2$s. %3$s"

msgid "Payment settings"
msgstr "Настройки оплаты"

msgid "Duplicate webhook processing in progress."
msgstr "Этот вебхук уже обрабатывается."

msgid "Canceled at gateway"
msgstr "Отменено в платёжной системе"

msgid "This subscription cannot be paused."
msgstr "Эту подписку нельзя приостановить."

msgid "Subscription paused manually"
msgstr "Подписка приостановлена вручную"

msgid "Current payment method does not support pausing."
msgstr "Текущий способ оплаты не поддерживает приостановку."

msgid "This subscription cannot be resumed."
msgstr "Эту подписку нельзя возобновить."

msgid "Subscription resumed manually"
msgstr "Подписка возобновлена вручную"

msgid "Current payment method does not support resuming."
msgstr "Текущий способ оплаты не поддерживает возобновление."

msgid "This subscription must be reactivated through its payment gateway."
msgstr "Эту подписку нужно возобновлять через её платёжную систему."

msgid "This subscription cannot be reactivated."
msgstr "Эту подписку нельзя возобновить."

msgid "Only store-billed (manual or auto-charge) subscriptions can be updated directly."
msgstr "Напрямую можно менять только подписки с оплатой через магазин (вручную или автосписанием)."

msgid "bill_times cannot be negative."
msgstr "bill_times не может быть отрицательным."

msgid "bill_times cannot be less than the number of payments already made (%d)."
msgstr "bill_times не может быть меньше числа уже сделанных платежей (%d)."

msgid "recurring_total cannot be negative."
msgstr "recurring_total не может быть отрицательным."

msgid "recurring_total cannot be less than the existing tax total."
msgstr "recurring_total не может быть меньше уже начисленного налога."

msgid "Invalid billing interval."
msgstr "Недопустимый интервал списаний."

msgid "No changes detected."
msgstr "Изменений нет."

msgid "Subscription paused; open renewal order voided."
msgstr "Подписка приостановлена, открытый заказ на продление аннулирован."

msgid "Canceled by admin edit"
msgstr "Отменено правкой администратора"

msgid "Subscription completed — billing times reached."
msgstr "Подписка завершена: число списаний достигнуто."

msgid "Another subscription on this payment method is already using this Vendor Subscription ID."
msgstr "Этот ID подписки в платёжной системе уже использует другая подписка с этим способом оплаты."

msgid "Subscription canceled"
msgstr "Подписка отменена"

msgid "%1$s cannot charge a saved payment method automatically."
msgstr "%1$s не умеет автоматически списывать с сохранённого способа оплаты."

msgid "The payment method on file"
msgstr "Сохранённый способ оплаты"

msgid "Automatic charging is disabled."
msgstr "Автоматическое списание отключено."

msgid "This invoice is in %1$s mode but the store is currently in %2$s mode. Switch the store mode to charge it."
msgstr "Этот счёт в режиме %1$s, а магазин сейчас в режиме %2$s. Переключите режим магазина, чтобы списать оплату."

msgid "Only an open (pending or scheduled) renewal order can be charged."
msgstr "Списать можно только по открытому (ожидающему или запланированному) заказу на продление."

msgid "Only auto-charged (system) subscriptions can be charged from here."
msgstr "Отсюда можно списывать только по подпискам с автосписанием."

msgid "A %1$s subscription cannot be charged."
msgstr "Подписку со статусом %1$s нельзя оплатить списанием."

msgid "The payment method for this subscription is unavailable or no longer supports automatic charging."
msgstr "Способ оплаты этой подписки недоступен или больше не поддерживает автоматическое списание."

msgid "A charge for this invoice was already submitted and is awaiting confirmation from the payment provider."
msgstr "Списание по этому счёту уже отправлено и ждёт подтверждения платёжной системы."

msgid "All charge attempts for this invoice have been used. Ask the customer to pay through their Pay Now link."
msgstr "Все попытки списания по этому счёту использованы. Попросите клиента оплатить по ссылке «Оплатить сейчас»."

msgid "The invoice was charged successfully and the subscription has renewed."
msgstr "Счёт оплачен, подписка продлена."

msgid "The charge was submitted and is awaiting confirmation from the payment provider."
msgstr "Списание отправлено и ждёт подтверждения платёжной системы."

msgid "The charge attempt did not complete. Check the subscription activity log for details."
msgstr "Попытка списания не завершилась. Подробности в журнале активности подписки."

msgid "Charge attempt %1$d was triggered manually: %2$s"
msgstr "Попытка списания %1$d запущена вручную: %2$s"

msgid "No pending transaction found for this renewal order."
msgstr "Для этого заказа на продление не найдено ожидающей транзакции."

msgid "The payment method for this subscription is unavailable."
msgstr "Способ оплаты этой подписки недоступен."

msgid "The payment was not confirmed within %1$d days."
msgstr "Платёж не подтвердился за %1$d дн."

msgid "No reviews yet. Be the first to write a review!"
msgstr "Отзывов пока нет. Станьте первым!"

msgid "Please select a rating"
msgstr "Выберите оценку"

msgid "Photo preview"
msgstr "Предпросмотр фото"


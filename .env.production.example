# Копируется в .env на сервере (рядом с docker-compose.prod.yml), не коммитится.
# DATABASE_URL для приложения собирается docker-compose'ом автоматически из
# POSTGRES_PASSWORD (см. docker-compose.prod.yml) — здесь его задавать не нужно.

POSTGRES_PASSWORD="replace-with-a-strong-random-password"

# Автотюнинг postgres.conf (docker-compose.prod.yml, db/pg-autotune-entrypoint.sh) —
# честная доля RAM/CPU, которую отдаём Postgres на ЭТОЙ машине, не вся RAM
# хоста (сервер общий с другими сайтами/почтой). shared_buffers/work_mem/
# effective_cache_size и т.д. считаются из этих двух чисел заново при каждом
# рестарте — при переезде на больший/выделенный сервер меняем только их.
# Если не заданы — используются дефолты 512/2/50 из docker-compose.prod.yml.
# PG_TUNE_TOTAL_MB="512"
# PG_TUNE_CPUS="2"
# PG_TUNE_MAX_CONNECTIONS="50"

# UID/GID владельца папки домена на хосте (см. `id <site-user>`, в
# ISPmanager это пользователь сайта, например md33) — public/uploads это
# bind-mount на папку домена, не именованный Docker-volume, поэтому
# контейнер должен писать под тем же UID/GID, что владеет папкой на хосте.
SITE_UID="1000"
SITE_GID="1000"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Секрет вебхуков FluentCart (docs/spec/06-super-admin.md, п.5) — тот же
# заголовок X-FluentCart-Webhook-Secret настраивается в фидах интеграции.
FLUENTCART_WEBHOOK_SECRET="replace-with-a-random-secret"

# Telegram-бот для сводок (Настройки -> Сводки). Оставьте пустыми, если модуль не используется.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# SMTP для email-сводок и восстановления пароля. Оставьте пустыми, если не используется.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Web Push (push-уведомления владельцу о сводках при установленном PWA).
# Сгенерировать один раз: npx web-push generate-vapid-keys — и больше не
# менять: смена пары ключей аннулирует все существующие подписки браузеров,
# владельцам придётся заново включать push в настройках.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Лендинг (docs/spec/08-landing.md). Соль обязательна — генерировать так же,
# openssl rand -base64 32, СВОЙ секрет для прода, не тот же, что в dev .env.
LANDING_STATS_SALT="replace-with-a-random-secret"
# Публичный адрес приложения — для canonical/OG-ссылок Лендинга.
SITE_URL="https://my.rentos365.app"

# Единый вход RentOS -> rentos365.app (WordPress с FluentCart и Fluent Support).
# Пусто = единый вход выключен: незаполненная переменная не должна открывать
# дверь, поэтому пустой список НЕ означает "разрешено всё".
# Origin'ы через запятую, только https — куда разрешено возвращать браузер с
# одноразовым кодом (без белого списка это открытый редирект).
SSO_ALLOWED_ORIGINS="https://rentos365.app"
# Общий секрет для обмена кода на данные владельца (сервер-сервер). Тот же
# секрет прописывается в сниппете на стороне WordPress.
SSO_SHARED_SECRET="replace-with-a-random-secret"

# Публичный адрес кабинета (аудит 2026-08-13). Из него строятся ссылки, которые
# УХОДЯТ В ПИСЬМАХ И QR: сброс пароля, активация устройства точки. Без этой
# переменной адрес брался бы из заголовка Host, то есть из запроса — а значит
# запрос "забыли пароль" с подменённым Host заставил бы сервер отправить
# владельцу настоящее письмо с настоящим токеном, но ссылкой на чужой домен.
# Без слэша на конце.
APP_ORIGIN="https://my.rentos365.app"

msgid "Review added successfully"
msgstr "Отзыв добавлен"

msgid "Back to Reviews"
msgstr "Назад к отзывам"

msgid "Invalid status"
msgstr "Недопустимый статус"

msgid "You can only reply to a review."
msgstr "Ответить можно только на отзыв."


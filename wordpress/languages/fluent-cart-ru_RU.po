msgstr "Включить фильтр по умолчанию"

msgid "Presets applied to the product query by default, independent of the visitor-facing filter above. Ignored when Is main query is enabled."
msgstr "Предустановки, которые применяются к выборке товаров по умолчанию, независимо от фильтра для посетителей выше. Не учитываются, когда включено «Основной запрос»."

msgid "Preset search term"
msgstr "Предустановленный поисковый запрос"

msgid "Show Sale Badge"
msgstr "Показывать значок скидки"

msgid "Show discount percentage instead"
msgstr "Показывать процент скидки"

msgid "Percentage Text"
msgstr "Текст процента"

msgid "Use {percent} as a placeholder for the discount amount, e.g. -{percent}%"
msgstr "Используйте {percent} вместо размера скидки, например -{percent}%"

msgid "Badge Shape"
msgstr "Форма значка"

msgid "Background Color"
msgstr "Цвет фона"

msgid "Show Sold Out Badge"
msgstr "Показывать значок «Распродано»"

msgid "%1$s is not an enabled currency with an exchange rate."
msgstr "%1$s не включена или для неё нет курса."

msgid "Amount is too large."
msgstr "Сумма слишком велика."

msgid "Shipping must be in whole units of the order currency."
msgstr "Доставка должна указываться в целых единицах валюты заказа."

msgid "Item shipping charges must add up to the shipping total."
msgstr "Стоимость доставки позиций должна в сумме давать общую стоимость доставки."

msgid "The discount must be in whole units of the order currency."
msgstr "Скидка должна указываться в целых единицах валюты заказа."

msgid "Trial items can't take a manual discount."
msgstr "На позиции с пробным периодом нельзя дать скидку вручную."

msgid "The discount cannot be more than the order subtotal."
msgstr "Скидка не может быть больше промежуточного итога заказа."

msgid "Rate must be a number above 0."
msgstr "Курс должен быть числом больше 0."

msgid "A product on this order no longer exists."
msgstr "Одного из товаров этого заказа больше не существует."

msgid "Prices must be zero or more."
msgstr "Цены должны быть нулевыми или больше."

msgid "Prices must be in whole units of the order currency."
msgstr "Цены должны указываться в целых единицах валюты заказа."

msgid "Setup Fee must be 0 or more."
msgstr "Плата за настройку должна быть 0 или больше."

msgid "Setup Fee Name must be plain text of 100 characters or fewer."
msgstr "Название платы за настройку: простой текст не длиннее 100 символов."

msgid "This coupon is restricted to specific email addresses"
msgstr "Этот купон действует только для определённых адресов почты"

msgid "Email confirmation and purchase recovery are unavailable. Please contact the store."
msgstr "Подтверждение почты и восстановление покупок недоступны. Свяжитесь с магазином."

msgid "Your email is confirmed. Past purchases are being recovered in the background. You can use your dashboard while recovery finishes."
msgstr "Ваша почта подтверждена. Прошлые покупки восстанавливаются в фоне, а пока можно пользоваться кабинетом."

msgid "Some past purchases could not be recovered. Request a new confirmation link to retry, or contact the store."
msgstr "Часть прошлых покупок восстановить не удалось. Запросите новую ссылку для подтверждения, чтобы повторить, или свяжитесь с магазином."

msgid "Confirmation email sent. Please check your inbox and follow the link to confirm your email address. If you cannot find it, check your spam folder."
msgstr "Письмо для подтверждения отправлено. Проверьте почту и перейдите по ссылке, чтобы подтвердить адрес. Если письма нет, загляните в папку «Спам»."

msgid "Your email address is confirmed and your purchases are now in this account."
msgstr "Ваш адрес почты подтверждён, покупки теперь в этом аккаунте."

msgid "Your email address is confirmed, but some purchases could not be moved. Please contact the store."
msgstr "Ваш адрес почты подтверждён, но часть покупок перенести не удалось. Свяжитесь с магазином."

msgid "Too many confirmation requests. Please try again in an hour."
msgstr "Слишком много запросов на подтверждение. Попробуйте через час."

msgid "Your email could not be confirmed. Please try again or contact the store."
msgstr "Не удалось подтвердить почту. Попробуйте ещё раз или свяжитесь с магазином."

msgid "The confirmation email could not be sent. Please try again."
msgstr "Не удалось отправить письмо для подтверждения. Попробуйте ещё раз."

msgid "This confirmation link has expired. Request a new one below."
msgstr "Срок действия ссылки истёк. Запросите новую ниже."

msgid "Sign in to the account that requested this confirmation link."
msgstr "Войдите в аккаунт, который запросил эту ссылку для подтверждения."

msgid "Your account has changed since this link was sent. Request a new one below."
msgstr "С тех пор как ссылка была отправлена, аккаунт изменился. Запросите новую ниже."

msgid "This confirmation link is no longer needed. Your email address is already confirmed."
msgstr "Эта ссылка больше не нужна: ваш адрес почты уже подтверждён."

msgid "This address belongs to another customer account. Please contact the store."
msgstr "Этот адрес принадлежит другому клиенту. Свяжитесь с магазином."

msgid "This confirmation link is not valid."
msgstr "Ссылка для подтверждения недействительна."

msgid "Email confirmation is not available."
msgstr "Подтверждение почты недоступно."

msgid "There is nothing to confirm for this account."
msgstr "В этом аккаунте нечего подтверждать."

msgid "The customer portal is not configured. Please contact the store."
msgstr "Кабинет клиента не настроен. Свяжитесь с магазином."

msgid "[%1$s] Confirm your email address"
msgstr "[%1$s] Подтвердите адрес почты"

msgid "Hello %1$s,"
msgstr "Здравствуйте, %1$s!"

msgid "Someone asked to use this address for their customer account on %1$s. Confirming will set %2$s as your contact email and bring any purchases made with it into your account."
msgstr "Кто-то попросил использовать этот адрес для своего аккаунта на %1$s. Подтвердив, вы сделаете %2$s контактной почтой и перенесёте в аккаунт все покупки, сделанные с этим адресом."

msgid "Confirm this address"
msgstr "Подтвердить адрес"

msgid "You will be asked to sign in first, so this link only works for the account that requested it. It expires in 24 hours."
msgstr "Сначала нужно будет войти, поэтому ссылка работает только для аккаунта, который её запросил. Она действует 24 часа."

msgid "If you did not ask for this, no action is needed and nothing has changed."
msgstr "Если вы этого не запрашивали, ничего делать не нужно, ничего не изменилось."

msgid "Notify customer when an automatic renewal charge fails"
msgstr "Уведомлять клиента, когда автоматическое списание за продление не прошло"

msgid "This email will be sent to the customer when their saved payment method could not be charged for a subscription renewal."
msgstr "Письмо уходит клиенту, когда с его сохранённого способа оплаты не удалось списать оплату за продление подписки."

msgid "Automatic Payment Failed for Renewal #{{order.invoice_no}}"
msgstr "Автоматический платёж за продление #{{order.invoice_no}} не прошёл"

msgid "Notify admin when an automatic renewal charge fails"
msgstr "Уведомлять администратора, когда автоматическое списание за продление не прошло"

msgid "This email will be sent to the admin when a saved payment method could not be charged for a subscription renewal."
msgstr "Письмо уходит администратору, когда с сохранённого способа оплаты не удалось списать оплату за продление подписки."

msgid "An automatic subscription renewal charge failed. Review the order in the FluentCart Dashboard."
msgstr "Автоматическое списание за продление подписки не прошло. Проверьте заказ в панели FluentCart."

msgid "Automatic Charge Failed for Renewal #{{order.invoice_no}}"
msgstr "Автосписание за продление #{{order.invoice_no}} не прошло"

msgid "Notify customer when a billing period is skipped"
msgstr "Уведомлять клиента, когда платёжный период пропущен"

msgid "This email will be sent to the customer when an admin skips their next billing period. The internal reason and actor are never included. Off by default."
msgstr "Письмо уходит клиенту, когда администратор пропускает его следующий платёжный период. Внутренняя причина и кто это сделал в письмо не попадают. По умолчанию выключено."

msgid "Your next payment has been skipped on {{settings.store_name}}"
msgstr "Ваш следующий платёж в {{settings.store_name}} пропущен"

msgid "Store-Managed Renewals"
msgstr "Продления через магазин"

msgid "Notify admin when a renewal order is created"
msgstr "Уведомлять администратора о создании заказа на продление"

msgid "This email will be sent to the admin when a renewal order is generated for a store-managed subscription."
msgstr "Письмо уходит администратору, когда создаётся заказ на продление подписки, которую оплачивают через магазин."

msgid "New Renewal Order Created on {{settings.store_name}}"
msgstr "Создан новый заказ на продление в {{settings.store_name}}"

msgid "Send the renewal order to the customer when a renewal order is created"
msgstr "Отправлять клиенту заказ на продление, когда он создан"

msgid "This email will be sent to the customer when a renewal order is generated for a store-managed subscription."
msgstr "Письмо уходит клиенту, когда создаётся заказ на продление подписки, которую оплачивают через магазин."

msgid "Your Subscription Renewal #{{order.invoice_no}}"
msgstr "Продление вашей подписки #{{order.invoice_no}}"

msgid "Store-Managed Renewals · Auto-Charge"
msgstr "Продления через магазин · Автосписание"

msgid "Notify customer before an automatic renewal charge"
msgstr "Уведомлять клиента перед автоматическим списанием за продление"

msgid "This email tells the customer the amount and date of the upcoming automatic charge to their saved payment method, when the renewal order is created ahead of the due date."
msgstr "Письмо сообщает клиенту сумму и дату предстоящего автоматического списания с его сохранённого способа оплаты, когда заказ на продление создаётся заранее."

msgid "Upcoming automatic payment for your subscription"
msgstr "Предстоящий автоматический платёж по вашей подписке"

msgid "This email will be sent to the customer when the saved payment method could not be charged for a renewal order. It includes the failure reason and a Pay Now link."
msgstr "Письмо уходит клиенту, когда с сохранённого способа оплаты не удалось списать оплату по заказу на продление. В нём есть причина и ссылка «Оплатить сейчас»."

msgid "This email will be sent to the admin when a saved payment method could not be charged for a renewal order."
msgstr "Письмо уходит администратору, когда с сохранённого способа оплаты не удалось списать оплату по заказу на продление."

msgid "Renewal due reminder copy to admin"
msgstr "Копия напоминания о сроке продления администратору"

msgid "This email will be sent to admin when a due reminder is sent to customer."
msgstr "Письмо уходит администратору, когда клиенту отправлено напоминание о сроке оплаты."

msgid "Renewal Reminder Sent #{{order.invoice_no}}"
msgstr "Отправлено напоминание о продлении #{{order.invoice_no}}"

msgid "Renewal due reminder to customer"
msgstr "Напоминание клиенту о сроке продления"

msgid "This email will be sent before/at renewal due date when payment is pending."
msgstr "Письмо уходит до наступления или в день срока продления, если оплата ещё не поступила."

msgid "Payment Reminder #{{order.invoice_no}}"
msgstr "Напоминание об оплате #{{order.invoice_no}}"

msgid "Notify admin when a subscription is past due"
msgstr "Уведомлять администратора о просрочке подписки"

msgid "This email will be sent to the admin when a subscription is marked as past due."
msgstr "Письмо уходит администратору, когда подписка помечена как просроченная."

msgid "Subscription Past Due #{{order.invoice_no}}"
msgstr "Подписка просрочена #{{order.invoice_no}}"

msgid "Notify customer when subscription is past due"
msgstr "Уведомлять клиента о просрочке подписки"

msgid "This email will be sent to the customer when their subscription is marked as past due."
msgstr "Письмо уходит клиенту, когда его подписка помечена как просроченная."

msgid "Your Subscription is Past Due on {{settings.store_name}}"
msgstr "Ваша подписка в {{settings.store_name}} просрочена"

msgid "First overdue renewal reminder to customer"
msgstr "Первое напоминание клиенту о просроченном продлении"

msgid "This email will be sent at the first overdue reminder day after a renewal due date while the payment is still pending."
msgstr "Письмо уходит в первый день напоминаний после срока продления, если оплата ещё не поступила."

msgid "Payment Reminder for Renewal #{{order.order_ref}}"
msgstr "Напоминание об оплате продления #{{order.order_ref}}"

msgid "Follow-up overdue renewal reminder to customer"
msgstr "Повторное напоминание клиенту о просроченном продлении"

msgid "This email will be sent at the intermediate overdue reminder days while the renewal payment remains pending."
msgstr "Письмо уходит в промежуточные дни напоминаний, пока оплата продления не поступила."

msgid "Payment Overdue for Renewal #{{order.order_ref}}"
msgstr "Просрочена оплата продления #{{order.order_ref}}"

msgid "Final overdue renewal notice to customer"
msgstr "Последнее уведомление клиенту о просроченном продлении"

msgid "This email will be sent at the last configured overdue reminder day while the renewal payment is still pending."
msgstr "Письмо уходит в последний настроенный день напоминаний, если оплата продления ещё не поступила."

msgid "Final Notice: Payment Overdue for Renewal #{{order.order_ref}}"
msgstr "Последнее уведомление: просрочена оплата продления #{{order.order_ref}}"

msgid "Review Actions"
msgstr "События отзывов"

msgid "Send mail to admin when a new review is submitted"
msgstr "Отправлять письмо администратору о новом отзыве"

msgid "Email admin when a customer submits a new review."
msgstr "Сообщать администратору, когда клиент оставил новый отзыв."

msgid "A new product review has been submitted."
msgstr "Получен новый отзыв о товаре."

msgid "New Review Submitted"
msgstr "Новый отзыв"

msgid "Send mail to the reviewer when their review is approved"
msgstr "Отправлять письмо автору, когда его отзыв одобрен"

msgid "Email the customer who wrote a review once it is approved and visible on the product page."
msgstr "Сообщать клиенту, написавшему отзыв, когда отзыв одобрен и виден на странице товара."

msgid "Your review is now live."
msgstr "Ваш отзыв опубликован."

msgid "Your review of {{review.product_title}} is now live"
msgstr "Ваш отзыв о {{review.product_title}} опубликован"

msgid "Send mail to the reviewer when the store replies to their review"
msgstr "Отправлять письмо автору, когда магазин ответил на его отзыв"

msgid "Email the customer who wrote a review when the store posts a reply to it."
msgstr "Сообщать клиенту, написавшему отзыв, когда магазин ответил на него."

msgid "The store has replied to your review."
msgstr "Магазин ответил на ваш отзыв."

msgid "{{settings.store_name}} replied to your review of {{review.product_title}}"
msgstr "{{settings.store_name}} ответил на ваш отзыв о {{review.product_title}}"

msgid "Your card was declined."
msgstr "Ваша карта отклонена."

msgid "A file named \"%s\" already exists in this bucket and existing files cannot be replaced. Upload it under a new name, for example by increasing the version number."
msgstr "Файл с именем «%s» уже есть в этом хранилище, а заменять существующие файлы нельзя. Загрузите его под новым именем, например увеличив номер версии."

msgid "A storage driver is required."
msgstr "Нужно выбрать хранилище."

msgid "The storage driver \"%1$s\" is not enabled."
msgstr "Хранилище «%1$s» не включено."

msgid "No bucket is configured for the \"%1$s\" storage driver."
msgstr "Для хранилища «%1$s» не настроен бакет."


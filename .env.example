DATABASE_URL="postgresql://teg:teg@localhost:5432/teg_saas?schema=public"

# Session/JWT secret for auth (login/password + PIN). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Super Admin account (npm run admin:seed / admin:reset-password), docs/spec/06-super-admin.md
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Secret expected in the X-FluentCart-Webhook-Secret header, docs/spec/06-super-admin.md п.5
FLUENTCART_WEBHOOK_SECRET="replace-with-a-random-secret"

# Optional fallbacks — normally set via /admin/settings (SystemSettings), kept here
# only so environments without that DB row configured yet still work.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Web Push (PWA push-уведомления владельцу о сводках).
# Generate once per environment with: npx web-push generate-vapid-keys
# Same key pair must stay stable — rotating it invalidates every existing
# browser push subscription (owners would need to re-enable push).
VAPID_PUBLIC_KEY="replace-with-generated-public-key"
VAPID_PRIVATE_KEY="replace-with-generated-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Единый вход RentOS -> rentos365.app (WordPress с FluentCart и Fluent Support).
# Пусто = единый вход выключен: незаполненная переменная не должна открывать
# дверь, поэтому пустой список НЕ означает "разрешено всё".
# Origin'ы через запятую, только https — куда разрешено возвращать браузер с
# одноразовым кодом (без белого списка это открытый редирект).
SSO_ALLOWED_ORIGINS="https://rentos365.app"
# Общий секрет для обмена кода на данные владельца (сервер-сервер). Тот же
# секрет прописывается в сниппете на стороне WordPress.
SSO_SHARED_SECRET="replace-with-a-random-secret"

msgid "Once you activate auto-forwarding for %s, the status will become active."
msgstr "Когда вы включите автоматическую пересылку для %s, статус станет активным."

msgid "Only a site administrator can connect, disconnect or switch Remote Portal."
msgstr "Подключать, отключать и переключать удалённый портал может только администратор сайта."

msgid "Page %1$s of %2$s"
msgstr "Страница %1$s из %2$s"

msgid "Please choose whether to move all tickets or only the selected ones."
msgstr "Выберите, переносить все заявки или только выбранные."

msgid "Please enable auto-forwarding of your emails from %s to the following address."
msgstr "Включите автоматическую пересылку писем с %s на этот адрес."

msgid "Please provide your Fluent Support license key."
msgstr "Укажите лицензионный ключ Fluent Support."

